generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth ───────────────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Karyawan ────────────────────────────────────────────────────────────────

enum EmploymentStatus {
  TETAP
  KONTRAK
  PROBATION
}

enum UserRole {
  KARYAWAN
  ADMIN
  SUPER_ADMIN
}

enum SalaryComponentType {
  TUNJANGAN
  POTONGAN
}

model Branch {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model Position {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  users     User[]
  createdAt DateTime @default(now())
}

model User {
  id               String           @id @default(cuid())
  employeeNo       Int?             @unique // No. Urut: tetap selamanya, tidak dipakai ulang
  employeeId       String?          @unique // kosong untuk SUPER_ADMIN (bukan karyawan)
  name             String
  email            String?          @unique
  emailVerified    DateTime?
  image            String?
  passwordHash     String?
  phone            String?
  role             UserRole         @default(KARYAWAN)
  employmentStatus EmploymentStatus @default(KONTRAK)
  departmentId     String?
  position         String?
  joinDate         DateTime?
  bankName         String?
  bankAccount      String?
  bankHolder       String?
  isActive         Boolean          @default(true)
  kantorkuId       String?
  menuAccess       String[]         @default([]) // menu yang dibuka super admin untuk ADMIN

  // Pekerjaan
  branch           String?
  managerId        String?
  contractEndDate  DateTime?        @db.Date
  resignDate       DateTime?        @db.Date
  paymentSchedule  String?

  // Data pribadi
  spkNumber        String?
  spkDate          DateTime?        @db.Date
  idType           String?
  ktpNumber        String?          @unique
  address          String?          @db.Text // alamat sesuai identitas
  currentAddress   String?          @db.Text
  addressSameAsId  Boolean          @default(false)
  birthPlace       String?
  birthDate        DateTime?        @db.Date
  gender           String?
  religion         String?
  maritalStatus    String?
  nationality      String?
  emergencyName    String?
  emergencyPhone   String?
  emergencyRelation String?

  // Pajak dan BPJS
  npwp             String?
  ptkpStatus       String?
  taxability       String?
  taxStatus        String?
  taxObjectCode    String?
  bpjsTkNumber     String?
  bpjsTkActive     Boolean          @default(false)
  bpjsKesNumber    String?
  bpjsKesActive    Boolean          @default(false)

  department   Department?   @relation(fields: [departmentId], references: [id])
  manager      User?         @relation("Atasan", fields: [managerId], references: [id], onDelete: SetNull)
  reports      User[]        @relation("Atasan")
  salaries     EmployeeSalary[]
  changeLogs   EmployeeChangeLog[]
  family       FamilyMember[]
  photo        EmployeePhoto?
  employmentEvents EmploymentEvent[]
  accounts     Account[]
  sessions     Session[]
  attendances  Attendance[]
  leaves       LeaveRequest[]
  businessTrips BusinessTrip[]
  payslips     Payslip[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Absensi ─────────────────────────────────────────────────────────────────

enum AttendanceStatus {
  HADIR
  IZIN
  SAKIT
  ALPHA
  CUTI
  DINAS
}

model Attendance {
  id          String           @id @default(cuid())
  userId      String
  date        DateTime         @db.Date
  checkIn     DateTime?
  checkOut    DateTime?
  checkInLat  Float?
  checkInLng  Float?
  checkOutLat Float?
  checkOutLng Float?
  checkInAddr String?
  checkOutAddr String?
  status      AttendanceStatus @default(HADIR)
  note        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([date])
}

// ─── Cuti ─────────────────────────────────────────────────────────────────────

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveType {
  TAHUNAN
  SAKIT
  MELAHIRKAN
  PENTING
  LAINNYA
}

model LeaveRequest {
  id          String      @id @default(cuid())
  userId      String
  type        LeaveType
  startDate   DateTime    @db.Date
  endDate     DateTime    @db.Date
  totalDays   Int
  reason      String      @db.Text
  status      LeaveStatus @default(PENDING)
  approvedBy  String?
  approvedAt  DateTime?
  note        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Dinas Luar ──────────────────────────────────────────────────────────────

model BusinessTrip {
  id          String      @id @default(cuid())
  userId      String
  destination String
  purpose     String      @db.Text
  startDate   DateTime    @db.Date
  endDate     DateTime    @db.Date
  totalDays   Int
  status      LeaveStatus @default(PENDING)
  approvedBy  String?
  approvedAt  DateTime?
  note        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Payslip ──────────────────────────────────────────────────────────────────

model Payslip {
  id              String   @id @default(cuid())
  userId          String
  period          String   // e.g. "2026-10"
  periodLabel     String   // e.g. "Oktober 2026"
  basicSalary     Float
  overtimePay     Float    @default(0)
  mealAllowance   Float    @default(0)
  travelAllowance Float    @default(0)
  otherBenefits   Float    @default(0)
  pph21           Float    @default(0)
  bpjsKesehatan   Float    @default(0)
  bpjsKetenagakerjaan Float @default(0)
  otherDeductions Float    @default(0)
  netPay          Float
  paidAt          DateTime?
  paidVia         String?  // e.g. "Transfer Bank Mandiri"

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  @@unique([userId, period])
  @@index([period])
}

// ─── Customer Project ─────────────────────────────────────────────────────────

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

model CustomerProject {
  id           String        @id @default(cuid())
  code         String        @unique
  clientName   String
  clientEmail  String?
  clientPhone  String?
  projectName  String
  description  String?       @db.Text
  status       ProjectStatus @default(PLANNING)
  startDate    DateTime?     @db.Date
  endDate      DateTime?     @db.Date
  progress     Int           @default(0)
  accessToken  String        @unique @default(cuid())
  updates      ProjectUpdate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProjectUpdate {
  id          String          @id @default(cuid())
  projectId   String
  title       String
  description String          @db.Text
  progress    Int
  images      String[]
  createdBy   String

  project CustomerProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

// ─── Riwayat gaji dan perubahan data ────────────────────────────────────────

// Setiap penyesuaian gaji adalah baris baru. Baris lama tidak pernah diubah,
// jadi riwayat beserta tanggal berlakunya selalu terjaga.
model EmployeeSalary {
  id            String   @id @default(cuid())
  userId        String
  effectiveDate DateTime @db.Date
  basicSalary   Float
  bpjsTkBase    Float?
  bpjsKesBase   Float?
  note          String?
  createdBy     String?
  createdAt     DateTime @default(now())

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  components SalaryComponent[]

  @@unique([userId, effectiveDate])
}

model SalaryComponent {
  id       String              @id @default(cuid())
  salaryId String
  type     SalaryComponentType
  name     String
  amount   Float

  salary EmployeeSalary @relation(fields: [salaryId], references: [id], onDelete: Cascade)

  @@index([salaryId])
}

model EmploymentEvent {
  id              String    @id @default(cuid())
  userId          String
  type            String // PERPANJANGAN atau PEMBERHENTIAN
  effectiveDate   DateTime  @db.Date
  contractEndDate DateTime? @db.Date
  spkNumber       String?
  spkDate         DateTime? @db.Date
  reason          String?
  createdBy       String?
  createdAt       DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, effectiveDate])
}

model EmployeePhoto {
  userId    String   @id
  data      Bytes
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FamilyMember {
  id        String   @id @default(cuid())
  userId    String
  name      String
  idNumber  String?
  relation  String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmployeeChangeLog {
  id        String   @id @default(cuid())
  userId    String
  field     String
  oldValue  String?
  newValue  String?
  changedBy String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
