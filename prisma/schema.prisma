generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth ───────────────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Karyawan ────────────────────────────────────────────────────────────────

enum EmploymentStatus {
  TETAP
  KONTRAK
  PROBATION
}

enum UserRole {
  KARYAWAN
  ADMIN
  SUPER_ADMIN
}

enum SalaryComponentType {
  TUNJANGAN
  POTONGAN
}

model Branch {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model Position {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  users     User[]
  createdAt DateTime @default(now())
}

model User {
  id               String           @id @default(cuid())
  employeeNo       Int?             @unique // No. Urut: tetap selamanya, tidak dipakai ulang
  employeeId       String?          @unique // kosong untuk SUPER_ADMIN (bukan karyawan)
  name             String
  email            String?          @unique
  emailVerified    DateTime?
  image            String?
  passwordHash     String?
  phone            String?
  role             UserRole         @default(KARYAWAN)
  employmentStatus EmploymentStatus @default(KONTRAK)
  departmentId     String?
  position         String?
  joinDate         DateTime?
  bankName         String?
  bankAccount      String?
  bankHolder       String?
  isActive         Boolean          @default(true)
  kantorkuId       String?
  menuAccess       String[]         @default([]) // menu yang dibuka super admin untuk ADMIN

  // Pekerjaan
  branch          String?
  managerId       String?
  contractEndDate DateTime? @db.Date
  resignDate      DateTime? @db.Date
  paymentSchedule String?

  // Data pribadi
  spkNumber         String?
  spkDate           DateTime? @db.Date
  idType            String?
  ktpNumber         String?   @unique
  address           String?   @db.Text // alamat sesuai identitas
  currentAddress    String?   @db.Text
  addressSameAsId   Boolean   @default(false)
  birthPlace        String?
  birthDate         DateTime? @db.Date
  gender            String?
  religion          String?
  maritalStatus     String?
  nationality       String?
  emergencyName     String?
  emergencyPhone    String?
  emergencyRelation String?

  // Pajak dan BPJS
  npwp          String?
  ptkpStatus    String?
  taxability    String?
  taxStatus     String?
  taxObjectCode String?
  bpjsTkNumber  String?
  bpjsTkActive  Boolean @default(false)
  bpjsKesNumber String?
  bpjsKesActive Boolean @default(false)

  department       Department?         @relation(fields: [departmentId], references: [id])
  manager          User?               @relation("Atasan", fields: [managerId], references: [id], onDelete: SetNull)
  reports          User[]              @relation("Atasan")
  salaries         EmployeeSalary[]
  changeLogs       EmployeeChangeLog[]
  family           FamilyMember[]
  photo            EmployeePhoto?
  employmentEvents EmploymentEvent[]
  workLocations    WorkLocation[]      @relation("UserWorkLocations")
  schedules        EmployeeSchedule[]
  shiftDays        EmployeeShiftDay[]
  leaveBalances    LeaveBalanceEntry[]
  payrollLines     PayrollLine[]
  payComponents    EmployeePayComponent[]
  accounts         Account[]
  sessions         Session[]
  attendances      Attendance[]
  leaves           LeaveRequest[]
  businessTrips    BusinessTrip[]
  payslips         Payslip[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Absensi ─────────────────────────────────────────────────────────────────

enum AttendanceStatus {
  HADIR
  IZIN
  SAKIT
  ALPHA
  CUTI
  DINAS
}

model Attendance {
  id               String           @id @default(cuid())
  userId           String
  date             DateTime         @db.Date
  checkIn          DateTime?
  checkOut         DateTime?
  checkInLat       Float?
  checkInLng       Float?
  checkOutLat      Float?
  checkOutLng      Float?
  checkInAddr      String?
  checkOutAddr     String?
  checkInLocation  String? // nama lokasi absen masuk, atau "Dinas Luar"
  checkOutLocation String? // nama lokasi absen pulang, atau "Dinas Luar"
  status           AttendanceStatus @default(HADIR)
  note             String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([date])
}

// ─── Cuti ─────────────────────────────────────────────────────────────────────

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveType {
  TAHUNAN
  SAKIT
  MELAHIRKAN
  PENTING
  LAINNYA
}

model LeaveRequest {
  id         String      @id @default(cuid())
  userId     String
  type       LeaveType
  startDate  DateTime    @db.Date
  endDate    DateTime    @db.Date
  totalDays  Int
  reason     String      @db.Text
  status     LeaveStatus @default(PENDING)
  approvedBy String?
  approvedAt DateTime?
  note       String?
  policyId   String? // jenis cuti dari Setup Leave; kosong untuk pengajuan lama

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  policy LeavePolicy? @relation(fields: [policyId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Dinas Luar ──────────────────────────────────────────────────────────────

model BusinessTrip {
  id          String      @id @default(cuid())
  userId      String
  destination String
  purpose     String      @db.Text
  startDate   DateTime    @db.Date
  endDate     DateTime    @db.Date
  totalDays   Int
  status      LeaveStatus @default(PENDING)
  approvedBy  String?
  approvedAt  DateTime?
  note        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Payslip ──────────────────────────────────────────────────────────────────

model Payslip {
  id                  String    @id @default(cuid())
  userId              String
  period              String // e.g. "2026-10"
  periodLabel         String // e.g. "Oktober 2026"
  basicSalary         Float
  overtimePay         Float     @default(0)
  mealAllowance       Float     @default(0)
  travelAllowance     Float     @default(0)
  otherBenefits       Float     @default(0)
  pph21               Float     @default(0)
  bpjsKesehatan       Float     @default(0)
  bpjsKetenagakerjaan Float     @default(0)
  otherDeductions     Float     @default(0)
  netPay              Float
  paidAt              DateTime?
  paidVia             String? // e.g. "Transfer Bank Mandiri"

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, period])
  @@index([period])
}

// ─── Customer Project ─────────────────────────────────────────────────────────

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

model CustomerProject {
  id          String          @id @default(cuid())
  code        String          @unique
  clientName  String
  clientEmail String?
  clientPhone String?
  projectName String
  description String?         @db.Text
  status      ProjectStatus   @default(PLANNING)
  startDate   DateTime?       @db.Date
  endDate     DateTime?       @db.Date
  progress    Int             @default(0)
  accessToken String          @unique @default(cuid())
  updates     ProjectUpdate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProjectUpdate {
  id          String   @id @default(cuid())
  projectId   String
  title       String
  description String   @db.Text
  progress    Int
  images      String[]
  createdBy   String

  project   CustomerProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())
}

// ─── Riwayat gaji dan perubahan data ────────────────────────────────────────

// Setiap penyesuaian gaji adalah baris baru. Baris lama tidak pernah diubah,
// jadi riwayat beserta tanggal berlakunya selalu terjaga.
model EmployeeSalary {
  id            String   @id @default(cuid())
  userId        String
  effectiveDate DateTime @db.Date
  basicSalary   Float // gaji bulanan; karyawan harian = gaji harian x pengali
  dailyWage     Float? // karyawan harian (payroll mingguan)
  monthlyFactor Float? // pengali gaji harian menjadi bulanan (dasar lembur, BPJS, THR)
  bpjsTkBase    Float?
  bpjsKesBase   Float?
  note          String?
  createdBy     String?
  createdAt     DateTime @default(now())

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  components SalaryComponent[]

  @@unique([userId, effectiveDate])
}

model SalaryComponent {
  id       String              @id @default(cuid())
  salaryId String
  type     SalaryComponentType
  name     String
  amount   Float
  code     String? // kode komponen di Setup Payroll (mis. TJ); kosong = diketik bebas

  salary EmployeeSalary @relation(fields: [salaryId], references: [id], onDelete: Cascade)

  @@index([salaryId])
}

model EmploymentEvent {
  id              String    @id @default(cuid())
  userId          String
  type            String // PERPANJANGAN atau PEMBERHENTIAN
  effectiveDate   DateTime  @db.Date
  contractEndDate DateTime? @db.Date
  spkNumber       String?
  spkDate         DateTime? @db.Date
  reason          String?
  createdBy       String?
  createdAt       DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, effectiveDate])
}

model EmployeePhoto {
  userId    String   @id
  data      Bytes
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FamilyMember {
  id        String   @id @default(cuid())
  userId    String
  name      String
  idNumber  String?
  relation  String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmployeeChangeLog {
  id        String   @id @default(cuid())
  userId    String
  field     String
  oldValue  String?
  newValue  String?
  changedBy String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ─── Schedule (parameter jadwal kerja) ─────────────────────────────────────
// Dasar penilaian kehadiran: terlambat, pulang cepat, alpha, dan lembur.

model WorkShift {
  id                  String   @id @default(cuid())
  code                String   @unique
  name                String
  color               String   @default("#10b981")
  isOff               Boolean  @default(false) // shift libur (OFF)
  startTime           String? // "08:00"
  endTime             String? // "17:00"; lebih kecil dari startTime berarti lewat tengah malam
  breaks              Json     @default("[]") // [{ "start": "12:00", "end": "13:00" }]
  lateTolerance       Int      @default(5) // menit
  earlyLeaveTolerance Int      @default(0) // menit
  checkInEarliest     Int      @default(60) // menit sebelum jam masuk
  checkOutLatest      Int      @default(360) // menit sesudah jam pulang
  overtimeStartAfter  Int      @default(30) // lembur dihitung setelah X menit dari jam pulang
  overtimeMinimum     Int      @default(60) // lembur minimal X menit
  overtimeRounding    Int      @default(30) // pembulatan ke bawah per X menit
  isActive            Boolean  @default(true)
  sortOrder           Int      @default(0) // urutan kartu shift (bisa digeser)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  patternDays  WorkPatternDay[]
  employeeDays EmployeeShiftDay[]
  locations    WorkLocation[]     @relation("ShiftWorkLocations")
}

model WorkPattern {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  cycleDays   Int      @default(7)
  startDate   DateTime @db.Date // hari pertama siklus (hari ke-1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  days      WorkPatternDay[]
  locations WorkLocation[]     @relation("PatternWorkLocations")
  employees EmployeeSchedule[]
}

model WorkPatternDay {
  id        String @id @default(cuid())
  patternId String
  dayIndex  Int // 0 = hari pertama siklus
  shiftId   String

  pattern WorkPattern @relation(fields: [patternId], references: [id], onDelete: Cascade)
  shift   WorkShift   @relation(fields: [shiftId], references: [id], onDelete: Restrict)

  @@unique([patternId, dayIndex])
}

enum HolidayType {
  NASIONAL
  CUTI_BERSAMA
  PERUSAHAAN
}

model Holiday {
  id        String      @id @default(cuid())
  date      DateTime    @unique @db.Date
  name      String
  type      HolidayType @default(NASIONAL)
  createdAt DateTime    @default(now())
}

// Aturan kehadiran yang berlaku untuk semua karyawan; hanya satu baris ("default").
model AttendanceRule {
  id                    String   @id @default("default")
  overtimeNeedsApproval Boolean  @default(true) // lembur harus diajukan & disetujui atasan
  holidayWorkIsOvertime Boolean  @default(true) // masuk di hari libur dihitung lembur hari libur
  halfDayMinutes        Int      @default(240) // kerja kurang dari ini dihitung setengah hari
  lateAsHalfDayMinutes  Int? // terlambat lebih dari ini dihitung setengah hari (kosong = tidak)
  noCheckInIsAlpha      Boolean  @default(true) // tidak absen & tanpa izin/cuti/sakit/dinas = Alpha
  updatedBy             String?
  updatedAt             DateTime @updatedAt
}

// Lokasi absen (geotagging). Bisa ditempel ke karyawan, shift, atau pola kerja;
// absen di luar radius semua lokasi yang diizinkan ditolak, kecuali saat Dinas Luar.
model WorkLocation {
  id        String   @id @default(cuid())
  name      String   @unique
  address   String?
  latitude  Float
  longitude Float
  radius    Int      @default(200) // meter
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employees User[]        @relation("UserWorkLocations")
  shifts    WorkShift[]   @relation("ShiftWorkLocations")
  patterns  WorkPattern[] @relation("PatternWorkLocations")
}

// Jadwal kerja karyawan dengan tanggal berlaku. Baris terbaru yang berlaku pada suatu
// tanggal menentukan jadwalnya: POLA memakai pola kerja; MANUAL diisi per tanggal (Security).
model EmployeeSchedule {
  id            String   @id @default(cuid())
  userId        String
  type          String // "POLA" atau "MANUAL"
  patternId     String?
  effectiveDate DateTime @db.Date
  note          String?
  createdBy     String?
  createdAt     DateTime @default(now())

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  pattern WorkPattern? @relation(fields: [patternId], references: [id], onDelete: Restrict)

  @@unique([userId, effectiveDate])
}

// Shift per tanggal untuk satu karyawan: isi jadwal manual (Security) atau tukar shift.
// Kalau ada, baris ini mengalahkan pola kerja dan hari libur pada tanggal itu.
model EmployeeShiftDay {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @db.Date
  shiftId   String
  note      String?
  updatedBy String?
  updatedAt DateTime @updatedAt

  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  shift WorkShift @relation(fields: [shiftId], references: [id], onDelete: Restrict)

  @@unique([userId, date])
  @@index([date])
}

// Setelan umum aplikasi (key → JSON), mis. pilihan running indikator Beranda.
model AppSetting {
  key       String   @id
  value     Json
  updatedBy String?
  updatedAt DateTime @updatedAt
}

// Kebijakan cuti/izin perusahaan (Setup Leave). Isi awal mengikuti UU Ketenagakerjaan dan
// UU KIA; pemilik bisa mengubah jumlah hari dan aturannya.
model LeavePolicy {
  id               String   @id @default(cuid())
  code             String   @unique
  name             String
  category         String // TAHUNAN | ISTIRAHAT_PANJANG | KHUSUS | MELAHIRKAN | SAKIT | IBADAH | DINAS | TANPA_UPAH | LAINNYA
  quota            Int? // kosong = sesuai kebutuhan / surat dokter
  unit             String   @default("HARI_KERJA") // HARI_KERJA | HARI_KALENDER | BULAN
  period           String   @default("KEJADIAN") // TAHUN | KEJADIAN
  minServiceMonths Int      @default(0) // masa kerja minimal sebelum berhak
  gender           String? // P = perempuan, L = laki-laki, kosong = semua
  forStatus        String? // TETAP | KONTRAK | kosong = semua status kerja
  accrualPerMonth  Float    @default(0) // saldo bertambah X hari tiap genap 1 bulan kerja (cuti masa kontrak)
  paid             Boolean  @default(true)
  payNote          String? // mis. "Bulan 1-4 upah penuh, bulan 5-6 75%"
  deductsAnnual    Boolean  @default(false) // memotong saldo cuti tahunan
  needsAttachment  Boolean  @default(false)
  attachmentNote   String? // mis. "Surat keterangan dokter"
  carryOverDays    Int      @default(0) // sisa yang boleh dibawa ke tahun berikutnya
  noticeDays       Int      @default(0) // diajukan paling lambat X hari sebelumnya
  legalBasis       String?
  note             String?  @db.Text
  isActive         Boolean  @default(true)
  sortOrder        Int      @default(0)
  updatedBy        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  balances LeaveBalanceEntry[]
  requests LeaveRequest[]
}

// Buku saldo cuti per karyawan. SALDO_AWAL = hasil migrasi dari aplikasi lama (per tanggal),
// PENYESUAIAN = koreksi manual (+/-). Penambahan rutin dan pemakaian dihitung otomatis.
model LeaveBalanceEntry {
  id        String   @id @default(cuid())
  userId    String
  policyId  String
  date      DateTime @db.Date
  days      Float
  kind      String // SALDO_AWAL | PENYESUAIAN
  note      String?
  createdBy String?
  createdAt DateTime @default(now())

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  policy LeavePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([userId, policyId])
}

// Komponen payroll & benefit perusahaan (Setup Payroll). Isi awal mengikuti UU Ketenagakerjaan,
// PP 35/2021 (lembur), PP 36/2021 (pengupahan), aturan BPJS, dan Permenaker 6/2016 (THR).
model PayComponent {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  kind        String // PENDAPATAN | POTONGAN | BENEFIT (ditanggung perusahaan, tidak mengurangi gaji)
  category    String // kategori pajak (1721-A1): GAJI | TUNJANGAN_PPH | TUNJANGAN_LAIN | HONORARIUM | PREMI_ASURANSI | NATURA | BONUS_THR | IURAN_PENSIUN | PPH21 | BUKAN_OBJEK
  method      String // INPUT | NOMINAL | PER_SATUAN | KELIPATAN | PERSEN | PRORATA | LEMBUR | THR | PPH21
  amount      Float? // nominal bawaan (mis. uang makan per hari)
  rate        Float? // persen (mis. 3.7)
  base        String? // GAJI_POKOK | UPAH_TETAP (pokok + tunjangan tetap) | UPAH_BPJS
  capAmount   Float? // batas atas dasar perhitungan
  floorAmount Float? // batas bawah dasar perhitungan
  params      Json? // koefisien rumus, mis. lembur {divisor, workday:[1.5,2], rest6:[2,3,4], rest5:[2,3,4]}, THR {months}
  baseCodes   String[] @default([]) // dasar = komponen yang dicentang (bila base = KOMPONEN)
  param       String? // parameter rumus: HARI_HADIR, HARI_MANGKIR, HARI_CUTI, HARI_DINAS, KALI_DINAS, HARI_KERJA, MASA_KERJA, JAM_LEMBUR
  taxable     Boolean  @default(true) // objek PPh 21
  legalBasis  String?
  note        String?  @db.Text
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employees EmployeePayComponent[]
}

// Proses gaji bulanan. DRAFT bisa dihitung ulang dan diubah; FINAL mengunci angka dan menerbitkan slip gaji.
model PayrollRun {
  id          String    @id @default(cuid())
  period      String    @unique // "2026-11"
  status      String    @default("DRAFT") // DRAFT | FINAL
  includeThr  Boolean   @default(false) // lama; diganti extraCodes
  extraCodes  String[]  @default([]) // komponen tidak rutin (THR, bonus) yang disertakan periode ini
  frequency   String    @default("BULANAN") // BULANAN (period 2026-11) | MINGGUAN (period = tanggal mulai minggu, 2026-11-09)
  note        String?
  createdBy   String?
  finalizedBy String?
  finalizedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  lines PayrollLine[]
}

// Hasil hitung gaji satu karyawan dalam satu periode.
model PayrollLine {
  id         String  @id @default(cuid())
  runId      String
  userId     String
  inputs     Json // hari hadir, mangkir, jam lembur, bonus, kasbon, dst.
  items      Json // rincian komponen [{code,name,kind,amount,detail,taxable}]
  gross      Float   @default(0) // penghasilan bruto untuk PPh 21
  earnings   Float   @default(0)
  deductions Float   @default(0)
  benefits   Float   @default(0)
  pph21      Float   @default(0)
  netPay     Float   @default(0)
  ptkp       String?
  terRate    Float?
  warning    String?
  updatedAt  DateTime @updatedAt

  run  PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([runId, userId])
  @@index([userId])
}

// Komponen payroll yang ditempel ke karyawan. Hanya komponen yang ditempel yang dihitung saat payroll run.
model EmployeePayComponent {
  id          String   @id @default(cuid())
  userId      String
  componentId String
  startDate   DateTime? @db.Date // mulai dapat komponen; kosong = sejak awal
  endDate     DateTime? @db.Date // berhenti dapat (mis. demosi); kosong = masih berlaku
  note        String? // keterangan, mis. nomor SK promosi/demosi
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  component PayComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)

  @@unique([userId, componentId])
  @@index([componentId])
}

